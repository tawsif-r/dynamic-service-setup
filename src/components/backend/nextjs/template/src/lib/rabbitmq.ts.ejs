<% if (has('rabbitmq')) { -%>
import { connect } from 'amqplib';

type RabbitChannel = Awaited<ReturnType<Awaited<ReturnType<typeof connect>>['createChannel']>>;

const globalForRabbitmq = globalThis as unknown as { rabbitmqChannel?: Promise<RabbitChannel> };

async function createChannel(): Promise<RabbitChannel> {
  const connection = await connect(process.env.RABBITMQ_URL ?? 'amqp://localhost:5672');
  return connection.createChannel();
}

// One channel, reused across hot reloads in dev.
export const getChannel = (): Promise<RabbitChannel> =>
  (globalForRabbitmq.rabbitmqChannel ??= createChannel());

if (process.env.NODE_ENV === 'production') delete globalForRabbitmq.rabbitmqChannel;
<% } -%>
