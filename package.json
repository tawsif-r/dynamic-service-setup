{
  "name": "create-app",
  "version": "0.1.0",
  "description": "Composable project scaffolding CLI — pick a backend, database, cache and infra, get a working project",
  "type": "module",
  "bin": {
    "create-app": "./bin/create-app.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "execa": "^9.4.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
