exports[`generateProject (v1 slice, no install/git) > produces the expected file tree and artifacts for a Next.js + Mongo stack > src/lib/db.ts 1`] = `
"import mongoose from 'mongoose';

const uri = process.env.MONGODB_URI ?? 'mongodb://localhost:27017/app';

// Reuse the connection across hot reloads / lambda invocations.
let promise: Promise<typeof mongoose> | undefined;

export function db(): Promise<typeof mongoose> {
  promise ??= mongoose.connect(uri);
  return promise;
}
"
`;

exports[`generateProject (v1 slice, no install/git) > produces the expected file tree and artifacts for an ASP.NET Minimal API + Postgres stack > Dockerfile 1`] = `
"# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY *.csproj ./
RUN dotnet restore
COPY . .
RUN dotnet publish -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 3000
ENV ASPNETCORE_URLS=http://+:3000
ENTRYPOINT ["dotnet", "orders_api.dll"]
"
`;

exports[`generateProject (v1 slice, no install/git) > produces the expected file tree and artifacts for an ASP.NET Minimal API + Postgres stack > Program.cs 1`] = `
"using Microsoft.EntityFrameworkCore;
using orders_api.Data;
using StackExchange.Redis;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddDbContext<AppDbContext>(options =>
    options.UseNpgsql(Environment.GetEnvironmentVariable("DATABASE_URL")));
builder.Services.AddSingleton<IConnectionMultiplexer>(_ =>
    ConnectionMultiplexer.Connect(Environment.GetEnvironmentVariable("REDIS_URL") ?? "localhost:6379"));

var app = builder.Build();

var startedAt = DateTimeOffset.UtcNow;
app.MapGet("/", () => Results.Ok(new
{
    status = "ok",
    uptime = Math.Max(0, (DateTimeOffset.UtcNow - startedAt).TotalSeconds),
}));

app.Run();
"
`;

exports[`generateProject (v1 slice, no install/git) > produces the expected file tree and artifacts for an ASP.NET Minimal API + Postgres stack > README.md 1`] = `
"# orders-api

Generated with \`create-app\`. This project has no runtime dependency on the generator.

## Stack

- **Backend:** ASP.NET Core (Minimal API)
- **Database:** PostgreSQL
- **Cache:** Redis
- **Containerization:** Docker + Docker Compose

## Components

### ASP.NET Core (Minimal API)

\`Program.cs\` wires up the app top-to-bottom: database/cache registration, then route handlers. Add more \`app.MapGet\`/\`app.MapPost\` calls per endpoint, or move groups of them into extension methods as the app grows.

### PostgreSQL

\`DATABASE_URL\` is the Postgres connection string. Node backends use TypeORM (\`synchronize\` is enabled outside production; switch to migrations before deploying). ASP.NET backends use EF Core via \`Npgsql.EntityFrameworkCore.PostgreSQL\`, registered on \`AppDbContext\` in \`Program.cs\`.

### Redis

\`REDIS_URL\` is the Redis connection string. NestJS: inject the \`@Global()\` \`RedisService\` (\`redisService.client\`). Next.js: import \`redis\` from \`src/lib/redis.ts\`. ASP.NET: a singleton \`IConnectionMultiplexer\` is registered in \`Program.cs\` via \`StackExchange.Redis\`.

### Docker

\`docker build -t <name> .\` builds the runtime image; the Compose file uses it.

### Docker Compose

\`docker compose up -d\` starts the app and its dependencies.

## Getting started

\`\`\`bash
dotnet restore
docker compose up -d
dotnet run
\`\`\`
"
`;

